# frameshuffle: deployment settings for docker compose.
#
#   cp .env.sample .env      # then edit .env (it is git-ignored; never commit it)
#
# Everything except PHOTOS_DIR is optional. Per-client settings (intervals, time windows,
# filters, display profiles) live in config/config.toml; see docs/configuration.md. Any
# FRAMESHUFFLE_* value set here overrides the same setting in config.toml. Empty = not set.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Absolute path of your photo folder on the Docker host. Mounted read-only; nothing is modified.
PHOTOS_DIR=/path/to/your/photos

# ---------------------------------------------------------------------------------------------
# Container image
# ---------------------------------------------------------------------------------------------

# Pull the published image (run `docker compose pull`). If unset, compose builds from source.
# The published image has no HEIC support; see WITH_HEIC below.
# FRAMESHUFFLE_IMAGE=YOUR_DOCKERHUB_USER/frameshuffle:latest

# HEIC/HEIF photos. The published image does NOT include a HEIC decoder (HEIC is HEVC video, and
# HEVC decoders may be covered by patents in some jurisdictions). Two ways to use HEIC photos:
#   1. Convert them once, locally:  scripts/convert-heic.sh /path/to/photos
#   2. Build your own image with a decoder: set WITH_HEIC=1 and run `docker compose up -d --build`.
#      (Only applies when building from source; it has no effect on a pulled FRAMESHUFFLE_IMAGE.)
#      Whether and how you may use or distribute an HEVC decoder is your responsibility.
WITH_HEIC=0

# ---------------------------------------------------------------------------------------------
# Networking and files
# ---------------------------------------------------------------------------------------------

# Host interface and port to publish. Use 127.0.0.1 if your reverse proxy (e.g. HAProxy) runs on
# the same host; keep 0.0.0.0 if it runs elsewhere.
BIND_ADDRESS=0.0.0.0
PORT=8080

# Folder holding the optional config.toml (mounted read-only at /config).
CONFIG_DIR=./config

# Timezone for client time windows (IANA name), and log level (error|warn|info|debug).
TZ=UTC
RUST_LOG=info

# ---------------------------------------------------------------------------------------------
# Security (strongly recommended if the port is reachable by anything you don't fully trust)
# ---------------------------------------------------------------------------------------------

# If set, image requests need ?token=VALUE or an "Authorization: Bearer VALUE" header.
FRAMESHUFFLE_TOKEN=
# If set, /admin/*, /stats and /metrics need it (also accepted on image requests).
FRAMESHUFFLE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------------------------
# Image processing
# ---------------------------------------------------------------------------------------------

# false = serve your original files untouched (right for FrameOS, which resizes and dithers itself).
# true  = convert every image to the client's display profile (resize, blurred padding, dithering).
FRAMESHUFFLE_PROCESSING=false
# Only in a build made with WITH_HEIC=1, and only when processing is off: transcode HEIC/HEIF to
# full-size JPEG (most displays can't decode HEIC). Has no effect in the official image.
FRAMESHUFFLE_CONVERT_HEIC=true
FRAMESHUFFLE_HEIC_QUALITY=92

# ---------------------------------------------------------------------------------------------
# Library scanning
# ---------------------------------------------------------------------------------------------

# Watch the folder for changes with inotify (local disks only; won't work on NFS/SMB mounts).
FRAMESHUFFLE_SCAN_WATCH=false
# Rescan on a timer instead (0 = off). Use this for network shares.
FRAMESHUFFLE_SCAN_PERIODIC_MINUTES=0
# Hashing workers for the initial scan. Disk-bound, so more rarely helps.
FRAMESHUFFLE_SCAN_THREADS=2

# ---------------------------------------------------------------------------------------------
# Defaults for clients not listed in config.toml (any ?client=NAME is created on first use)
# ---------------------------------------------------------------------------------------------

# Display profile (only used when processing is on): e1004, e1004-dithered, android-1080p, or your own.
FRAMESHUFFLE_DEFAULT_PROFILE=e1004
# Seconds the same image stays up before the next one is dealt. 0 = new image on every request.
FRAMESHUFFLE_DEFAULT_INTERVAL_SECS=3600

# ---------------------------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------------------------

# Size cap for the converted-image cache (MB); oldest files are evicted beyond it.
FRAMESHUFFLE_CACHE_MAX_MB=2048
# Simultaneous image conversions.
FRAMESHUFFLE_RENDER_CONCURRENCY=2
